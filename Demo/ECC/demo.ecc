def id : Π A : Type 0 . A → A := λ A : Type 0 . λ x : A . x
def False : Prop := Π P : Prop . P
def Not : Prop → Prop := λ P : Prop . P → False
def Nat : Type 1 := Π A : Type 0 . (A → A) → A → A
def zero : Nat := λ A : Type 0 . λ f : A → A . λ x : A . x
def succ : Nat → Nat := λ n : Nat . λ A : Type 0 . λ f : A → A . λ x : A . f (n A f x)
def plus : Nat → Nat → Nat := λ m : Nat . λ n : Nat . λ A : Type 0 . λ f : A → A . λ x : A . m A f (n A f x)
def two : Nat := succ (succ zero)
def four : Nat := plus two two
def PNat : Prop := Π P : Prop . (P → P) → P → P
def ptwo : PNat := λ P : Prop . λ f : P → P . λ x : P . f (f x)
def Eq : Π A : Type 1 . A → A → Prop := λ A : Type 1 . λ x : A . λ y : A . Π P : A → Prop . P x → P y
def refl : Π A : Type 1 . Π x : A . Eq A x x := λ A : Type 1 . λ x : A . λ P : A → Prop . λ p : P x . p
def four_eq : Eq Nat four (plus two two) := refl Nat four
def PropIsType : Type 0 := Prop
def lifted : Type 2 := Nat
def U : Type 1 := Type 0 → Prop
def idProp : Prop → Prop := id Prop
def polyId : Π A : Type 2 . A → A := λ A : Type 2 . λ x : A . x
def idNat : Nat → Nat := polyId Nat
def idType0 : Type 0 → Type 0 := polyId (Type 0)
def bareType : Type 1 := Type
