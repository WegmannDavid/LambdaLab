def id : Π A : * . A → A := λ A : * . λ x : A . x
def Nat : * := Π A : * . (A → A) → A → A
def zero : Nat := λ A : * . λ f : A → A . λ x : A . x
def succ : Nat → Nat := λ n : Nat . λ A : * . λ f : A → A . λ x : A . f (n A f x)
def plus : Nat → Nat → Nat := λm : Nat. λn : Nat. λA : *. λf : A→A. λx : A. m A f (n A f x)
def two : Nat := succ (succ zero)
def four : Nat := plus two two
def Eq : Π A : * . A → A → * := λ A : * . λ x : A . λ y : A . Π P : A → * . P x → P y
def refl : Π A : * . Π x : A . Eq A x x := λ A : * . λ x : A . λ P : A → * . λ p : P x . p
def four_eq : Eq Nat four (plus two two) := refl Nat four
def Rel : □ := * → * → *
def Pair : Rel := λ A : * . λ B : * . Π C : * . (A → B → C) → C
